{
  "name": "codesuab/laravel-permission",
  "description": "Simple, secure and framework-native roles and permissions for Laravel, Blade and Inertia.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://codesuab.github.io/laravel-permission/",
  "authors": [
    {
      "name": "codesuab",
      "email": "sahabuab@gmail.com",
      "homepage": "https://codesuab.com",
      "role": "Developer"
    }
  ],
  "archive": {
    "exclude": [
      "/docs/",
      "/.github/"
    ]
  },
  "require": {
    "php": "^8.2",
    "illuminate/auth": "^11.0|^12.0|^13.0",
    "illuminate/cache": "^11.0|^12.0|^13.0",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/view": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Codesuab\\Permission\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Codesuab\\Permission\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Codesuab\\Permission\\PermissionServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
